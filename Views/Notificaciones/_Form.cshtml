@model PlataformaMunicipal.Models.Notificacion

<form asp-action="@(Model.NotificacionId == 0 ? "Crear" : "Editar")" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.NotificacionId == 0 ? "Nueva notificación" : "Editar notificación")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="NotificacionId" />
        <input type="hidden" asp-for="FechaEnvio" />
        <input type="hidden" asp-for="FechaLectura" />
        <input type="hidden" asp-for="Leida" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="UsuarioId" class="form-label">Destinatario</label>
                <select asp-for="UsuarioId" asp-items="ViewBag.Usuarios" class="form-select">
                    <option value="">— Seleccione —</option>
                </select>
                <span asp-validation-for="UsuarioId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SolicitudId" class="form-label">Solicitud (opcional)</label>
                <select asp-for="SolicitudId" asp-items="ViewBag.Solicitudes" class="form-select">
                    <option value="">— Ninguna —</option>
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Titulo" class="form-label">Título</label>
                <input asp-for="Titulo" class="form-control" maxlength="120" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Mensaje" class="form-label">Mensaje</label>
                <textarea asp-for="Mensaje" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Mensaje" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Tipo" class="form-label">Tipo</label>
                <select asp-for="Tipo" asp-items="ViewBag.Tipos" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="Canal" class="form-label">Canal</label>
                <select asp-for="Canal" asp-items="ViewBag.Canales" class="form-select"></select>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>