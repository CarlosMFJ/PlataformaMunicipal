@model IEnumerable<PlataformaMunicipal.Models.EstadoSolicitud>
@{
    ViewData["Title"] = "Estados de solicitud";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Estados de solicitud</h4>
    <button class="btn btn-primary btn-modal" data-url="@Url.Action("Crear")">
        <i class="bi bi-plus-lg"></i> Nuevo
    </button>
</div>

<div class="card">
    <div class="card-body">
        <table id="tabla" class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Orden</th>
                    <th>Nombre</th>
                    <th>Color</th>
                    <th>Descripción</th>
                    <th>Inicial</th>
                    <th>Final</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.Orden</td>
                        <td><span class="badge" style="background-color:@e.Color">@e.Nombre</span></td>
                        <td><code>@e.Color</code></td>
                        <td>@e.Descripcion</td>
                        <td>@(e.EsInicial ? "Sí" : "No")</td>
                        <td>@(e.EsFinal ? "Sí" : "No")</td>
                        <td>
                            @if (e.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary btn-modal" data-url="@Url.Action("Editar", new { id = e.EstadoId })">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (e.Activo)
                            {
                                <button class="btn btn-sm btn-outline-danger btn-eliminar" data-url="@Url.Action("Eliminar", new { id = e.EstadoId })">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_DataTablesScripts" />
}