@model PlataformaMunicipal.Models.EstadoSolicitud

<form asp-action="@(Model.EstadoId == 0 ? "Crear" : "Editar")" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.EstadoId == 0 ? "Nuevo estado" : "Editar estado")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="EstadoId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Orden" class="form-label">Orden</label>
                <input asp-for="Orden" type="number" min="1" class="form-control" />
                <span asp-validation-for="Orden" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Color" class="form-label">Color</label>
                <input asp-for="Color" type="color" class="form-control form-control-color w-100" />
            </div>
            <div class="col-12">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-4">
                <div class="form-check">
                    <input asp-for="EsInicial" class="form-check-input" />
                    <label asp-for="EsInicial" class="form-check-label">Estado inicial</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check">
                    <input asp-for="EsFinal" class="form-check-input" />
                    <label asp-for="EsFinal" class="form-check-label">Estado final</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check">
                    <input asp-for="Activo" class="form-check-input" />
                    <label asp-for="Activo" class="form-check-label">Activo</label>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>