@model PlataformaMunicipal.Models.SolicitudCiudadana
@{
    var esNueva = Model.SolicitudId == 0;
}

<form asp-action="@(esNueva ? "Crear" : "Editar")" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(esNueva ? "Nueva solicitud" : "Editar " + Model.NumeroSolicitud)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="SolicitudId" />
        <input type="hidden" asp-for="NumeroSolicitud" />
        <input type="hidden" asp-for="EstadoId" />
        <input type="hidden" asp-for="FechaSolicitud" />
        <input type="hidden" asp-for="FechaLimite" />
        <input type="hidden" asp-for="FechaResolucion" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CiudadanoId" class="form-label">Ciudadano</label>
                @if (esNueva)
                {
                    <select asp-for="CiudadanoId" asp-items="ViewBag.Ciudadanos" class="form-select">
                        <option value="0">— Seleccione —</option>
                    </select>
                }
                else
                {
                    <select asp-items="ViewBag.Ciudadanos" class="form-select" disabled></select>
                    <input type="hidden" asp-for="CiudadanoId" />
                }
                <span asp-validation-for="CiudadanoId" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ServicioId" class="form-label">Servicio</label>
                @if (esNueva)
                {
                    <select asp-for="ServicioId" asp-items="ViewBag.Servicios" class="form-select">
                        <option value="0">— Seleccione —</option>
                    </select>
                }
                else
                {
                    <select asp-items="ViewBag.Servicios" class="form-select" disabled></select>
                    <input type="hidden" asp-for="ServicioId" />
                }
                <span asp-validation-for="ServicioId" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Asunto" class="form-label">Asunto</label>
                <input asp-for="Asunto" class="form-control" maxlength="150" />
                <span asp-validation-for="Asunto" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-md-4">
                <label asp-for="Prioridad" class="form-label">Prioridad</label>
                <select asp-for="Prioridad" asp-items="ViewBag.Prioridades" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="Canal" class="form-label">Canal</label>
                <select asp-for="Canal" asp-items="ViewBag.Canales" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="DireccionIncidente" class="form-label">Dirección del incidente</label>
                <input asp-for="DireccionIncidente" class="form-control" maxlength="250" />
            </div>
            <div class="col-12">
                <label asp-for="Observaciones" class="form-label">Observaciones</label>
                <textarea asp-for="Observaciones" class="form-control" rows="2" maxlength="500"></textarea>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>