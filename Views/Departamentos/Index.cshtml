@model IEnumerable<PlataformaMunicipal.Models.Departamento>
@{
    ViewData["Title"] = "Departamentos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Departamentos</h4>
    <button class="btn btn-primary btn-modal" data-url="@Url.Action("Crear")">
        <i class="bi bi-plus-lg"></i> Nuevo
    </button>
</div>

<div class="card">
    <div class="card-body">
        <table id="tabla" class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Jefe</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Codigo</td>
                        <td>@d.Nombre</td>
                        <td>@d.Telefono</td>
                        <td>@(d.JefeEmpleado != null ? d.JefeEmpleado.Nombres + " " + d.JefeEmpleado.Apellidos : "—")</td>
                        <td>
                            @if (d.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary btn-modal" data-url="@Url.Action("Editar", new { id = d.DepartamentoId })">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (d.Activo)
                            {
                                <button class="btn btn-sm btn-outline-danger btn-eliminar" data-url="@Url.Action("Eliminar", new { id = d.DepartamentoId })">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $('#tabla').DataTable({
            language: { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json' }
        });
    </script>
}