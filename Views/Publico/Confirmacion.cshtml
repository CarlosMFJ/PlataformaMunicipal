@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Solicitud registrada</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: #F4F7FA;
        }

        .btn-primary {
            background: #2C5F7C;
            border-color: #2C5F7C;
        }

        .numero {
            font-size: 2rem;
            font-weight: 700;
            color: #2C5F7C;
            letter-spacing: .05em;
        }
    </style>
</head>
<body>
    <div class="container py-5 text-center" style="max-width:560px">
        <div class="card shadow-sm">
            <div class="card-body p-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
                <h4 class="mt-3">¡Solicitud registrada!</h4>
                <p class="text-muted">Guarde este número para dar seguimiento:</p>
                <div class="numero mb-3">@ViewBag.Numero</div>
                <p class="small text-muted">
                    Para consultar el estado necesitará este número y su cédula.
                </p>
                <a asp-action="Index" class="btn btn-primary">Volver al inicio</a>
            </div>
        </div>
    </div>
</body>
</html>