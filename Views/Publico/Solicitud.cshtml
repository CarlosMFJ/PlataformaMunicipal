@model PlataformaMunicipal.ViewModels.SolicitudViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Solicitar un servicio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: #F4F7FA;
            color: #2B2B2B;
        }

        .nav-top {
            background: #2C5F7C;
        }

        .card {
            border: 1px solid #DDE4EA;
            border-radius: 10px;
        }

        .cabecera {
            border-left: 5px solid #4E9F7D;
            padding-left: 1rem;
        }

        .btn-primary {
            background: #2C5F7C;
            border-color: #2C5F7C;
        }

            .btn-primary:hover {
                background: #244d65;
                border-color: #244d65;
            }

        .trampa {
            position: absolute;
            left: -9999px;
        }
    </style>
</head>
<body>
    <nav class="nav-top navbar navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-action="Index"><i class="bi bi-building"></i> Ayuntamiento</a>
        </div>
    </nav>

    <div class="container py-4" style="max-width:800px">
        <div class="card">
            <div class="card-body p-4">
                <div class="cabecera mb-4">
                    <h4 class="mb-1"><i class="bi bi-file-earmark-text text-success"></i> Solicitar un servicio</h4>
                    <p class="text-muted mb-0">Pida un trámite o servicio municipal. Recibirá un número (SOL-...) para dar seguimiento.</p>
                </div>

                <form asp-action="Solicitud" method="post" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <div class="trampa"><input asp-for="Sitio" tabindex="-1" autocomplete="off" /></div>

                    <partial name="_DatosCiudadano" model="Model" />

                    <h6 class="text-primary">Datos de la solicitud</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ServicioId" class="form-label">Servicio que necesita</label>
                            <select asp-for="ServicioId" asp-items="ViewBag.Servicios" class="form-select">
                                <option value="0">— Seleccione —</option>
                            </select>
                            <span asp-validation-for="ServicioId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Asunto" class="form-label">Asunto</label>
                            <input asp-for="Asunto" class="form-control" maxlength="150" placeholder="Ej. Permiso de construcción" />
                            <span asp-validation-for="Asunto" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" id="descripcion" class="form-control" rows="4" maxlength="2000"></textarea>
                            <div class="d-flex justify-content-between">
                                <span asp-validation-for="Descripcion" class="text-danger small"></span>
                                <small class="text-muted"><span id="contador">0</span>/2000 (mínimo 10)</small>
                            </div>
                        </div>
                        <div class="col-12">
                            <label asp-for="Observaciones" class="form-label"></label>
                            <textarea asp-for="Observaciones" class="form-control" rows="2" maxlength="500"></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Enviar solicitud</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <partial name="_ScriptsFormulario" />
</body>
</html>