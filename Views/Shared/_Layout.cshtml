<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plataforma Municipal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="sidebar">
        <div class="brand"><i class="bi bi-building"></i> Plataforma Municipal</div>

        <div class="seccion">Principal</div>
        <a class="nav-item" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard</a>

        <div class="seccion">Servicios</div>
        <a class="nav-item" href="#"><i class="bi bi-inbox"></i>Solicitudes</a>
        <a class="nav-item" href="#"><i class="bi bi-people"></i>Ciudadanos</a>
        <a class="nav-item" href="#"><i class="bi bi-list-check"></i>Servicios</a>
        @if (User.IsInRole("Administrador") || User.IsInRole("Director") || User.IsInRole("Jefe de Departamento"))
        {
            <a class="nav-item" asp-controller="Sectores" asp-action="Index"><i class="bi bi-geo-alt"></i>Sectores</a>
            <a class="nav-item" asp-controller="Asignaciones" asp-action="Index"><i class="bi bi-diagram-2"></i>Asignaciones</a>
        }
        @if (User.IsInRole("Administrador") || User.IsInRole("Director"))
        {
            <div class="seccion">Administración</div>
            <a class="nav-item" asp-controller="Departamentos" asp-action="Index"><i class="bi bi-diagram-3"></i>Departamentos</a>
            <a class="nav-item" asp-controller="Empleados" asp-action="Index"><i class="bi bi-person-badge"></i>Empleados</a>
            <a class="nav-item" asp-controller="Estados" asp-action="Index"><i class="bi bi-flag"></i>Estados</a>
            <a class="nav-item" asp-controller="Solicitudes" asp-action="Index"><i class="bi bi-inbox"></i>Solicitudes</a>
            <a class="nav-item" asp-controller="Servicios" asp-action="Index"><i class="bi bi-list-check"></i>Servicios</a>
            <a class="nav-item" asp-controller="Notificaciones" asp-action="Index"><i class="bi bi-bell"></i>Notificaciones</a>
        }
        @if (User.IsInRole("Administrador"))
        {
            <a class="nav-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-person-gear"></i>Usuarios</a>
            <a class="nav-item" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-lock"></i>Roles</a>
        }
    </nav>

    <div class="contenido">
        <div class="topbar">
            <strong>@ViewData["Title"]</strong>
            <div>
                <i class="bi bi-person-circle"></i> @User.Identity?.Name
                <span class="badge bg-secondary ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-3">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Salir</button>
                </form>
            </div>
        </div>
        <main class="main-area">
            @RenderBody()
        </main>
    </div>

    <!-- Modal compartido para formularios -->
    <div class="modal fade" id="modalForm" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="modalContent"></div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/modales.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>