@model IEnumerable<PlataformaMunicipal.Models.Ciudadano>
@{
    ViewData["Title"] = "Ciudadanos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Ciudadanos</h4>
    <button class="btn btn-primary btn-modal" data-url="@Url.Action("Crear")">
        <i class="bi bi-plus-lg"></i> Nuevo
    </button>
</div>

<div class="card">
    <div class="card-body">
        <table id="tabla" class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Sector</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@(c.Cedula.Length == 11 ? $"{c.Cedula[..3]}-{c.Cedula[3..10]}-{c.Cedula[10..]}" : c.Cedula)</td>
                        <td>@c.Nombres @c.Apellidos</td>
                        <td>@(c.Telefono is { Length: 10 } t ? $"{t[..3]}-{t[3..6]}-{t[6..]}" : c.Telefono)</td>
                        <td>@(c.Sector?.Nombre ?? "—")</td>
                        <td>@c.Correo</td>
                        <td>
                            @if (c.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary btn-modal" data-url="@Url.Action("Editar", new { id = c.CiudadanoId })">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (c.Activo)
                            {
                                <button class="btn btn-sm btn-outline-danger btn-eliminar" data-url="@Url.Action("Eliminar", new { id = c.CiudadanoId })">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_DataTablesScripts" />
}