@model PlataformaMunicipal.Models.Sector

<form asp-action="@(Model.SectorId == 0 ? "Crear" : "Editar")" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.SectorId == 0 ? "Nuevo sector" : "Editar sector")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" asp-for="SectorId" />
        <input type="hidden" asp-for="FechaCreacion" />
        <input type="hidden" asp-for="Codigo" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Código</label>
                <input class="form-control" value="@Model.Codigo" readonly tabindex="-1" />
                
            </div>
            <div class="col-md-8">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" maxlength="100" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Municipio" class="form-label">Municipio</label>
                <input asp-for="Municipio" class="form-control" maxlength="100" />
                <span asp-validation-for="Municipio" class="text-danger small"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="Activo" class="form-check-input" />
                    <label asp-for="Activo" class="form-check-label">Activo</label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="2" maxlength="300"></textarea>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>